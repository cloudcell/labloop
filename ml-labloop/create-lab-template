note "display mode: ${RES_X}x${RES_Y} @ ${REFRESH} Hz (greeter + login autostart)"
# the XML pins the EDID native mode; non-native rates (60, 59.94, 30…)
# are injected by the login hook as a reduced-blanking modeline. Two
# hooks run the same script: lightdm display-setup (root, before the
# greeter — so the login screen is already at the right mode) and the
# XDG autostart (repair path if a session profile re-applied the old
# one). The --fb/--panning on the xrandr call is what keeps the pointer
# from staying clamped to the pre-switch geometry.
printf 'RES_X=%s\nRES_Y=%s\nREFRESH=%s\n' "$RES_X" "$RES_Y" "$REFRESH" \
    > "$WORK/display.conf"
qga_push "$WORK/display.conf" /tmp/labloop-display.conf
