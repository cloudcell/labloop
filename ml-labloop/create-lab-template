# opt-in patches land on the Desktop, NOT in the workspace payload —
# they contain operator-local config (model names, endpoint IPs) that
# the hostile zone's read-only mount has no business seeing.
note "optional-patches -> ~/Desktop/optional-patches (opt-in, run by hand)"
# LABLOOP_PATCHES_DIR overrides the payload source — optional-patches is
# blacklisted from the public export, so builds run from the staged copy
# must point at the private dir explicitly. tolerate absence either way:
# a literal unmatched glob in qga_push dies on FileNotFoundError and
# kills the whole provision.
PATCHES_DIR="${LABLOOP_PATCHES_DIR:-$REPO/optional-patches}"
# staged public copies can't carry optional-patches (blacklisted —
# operator-local config), so a pipeline run from the staged tree
# falls back to the sibling source repo: <staged>/../../ml-labloop.
# Whatever is in that dir bakes in — no env var required.
if [ ! -d "$PATCHES_DIR" ]; then
    cand="$(cd "$REPO/../.." 2>/dev/null && pwd)/ml-labloop/optional-patches"
    [ -d "$cand" ] && PATCHES_DIR="$cand"
fi
if [ -d "$PATCHES_DIR" ]; then
    qga "install -d -m 0755 -o lab -g lab /home/lab/Desktop/optional-patches"
    for f in "$PATCHES_DIR"/*; do
        b="$(basename "$f")"
        mode=0644; case "$b" in *.sh) mode=0755 ;; esac
        qga_push "$f" "/tmp/opatch-$b"
        qga "install -m $mode -o lab -g lab '/tmp/opatch-$b' \
             '/home/lab/Desktop/optional-patches/$b' && rm -f '/tmp/opatch-$b'"
    done
else
    echo "    (no patches dir — set LABLOOP_PATCHES_DIR or skipping)"
fi

note "panel clock: %H:%M %Z + UTC (first-login autostart fixer)"
# the perchannel XML does not exist until lab's first graphical login,
# so the durable fix is an autostart hook that sets it via xfconf-query.
# The plugin id is discovered dynamically (Mint assigns plugin-N).
qga_push "$REPO/deploy/labloop-panel-clock.sh" /tmp/labloop-panel-clock.sh
qga_push "$REPO/deploy/labloop-panel-clock.desktop" /tmp/labloop-panel-clock.desktop
qga "install -d -m 0755 /usr/local/libexec && \
     install -m 0755 /tmp/labloop-panel-clock.sh /usr/local/libexec/ && \
     install -m 0644 /tmp/labloop-panel-clock.desktop /etc/xdg/autostart/ && \
     rm -f /tmp/labloop-panel-clock.*"
# best-effort immediate patch too — covers the case where lab's panel
# config already exists (template re-provision after a session)
qga "python3 - <<'EOF'
import re
p = '/home/lab/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml'
try:
    xml = open(p).read()
except FileNotFoundError:
    raise SystemExit(0)
for m in re.finditer(r'(<property name=\"plugin-\d+\" type=\"empty\">)(.*?)(</property>)', xml, re.S):
    if 'value=\"clock\"' not in m.group(2):
        continue
    blk = m.group(2).replace(
        '<property name=\"digital-time-format\" type=\"empty\"/>',
        '<property name=\"digital-time-format\" type=\"string\" value=\"%H:%M %Z\"/>')
    if 'name=\"timezone\"' not in blk:
        blk = blk.rstrip() + '\n      <property name=\"timezone\" type=\"string\" value=\"UTC\"/>\n    '
    xml = xml[:m.start()] + m.group(1) + blk + m.group(3) + xml[m.end():]
    open(p, 'w').write(xml)
    break
EOF
chown lab:lab /home/lab/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml 2>/dev/null || true"
