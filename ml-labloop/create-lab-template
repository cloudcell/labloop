         /etc/lightdm/lightdm.conf.d && \
     install -m 0644 /tmp/labloop-display.conf /etc/labloop/display.conf && \
     install -m 0755 /tmp/labloop-display.sh /usr/local/libexec/ && \
     install -m 0644 /tmp/labloop-display.desktop /etc/xdg/autostart/ && \
     install -m 0644 /tmp/labloop-display-lightdm.conf \
         /etc/lightdm/lightdm.conf.d/50-labloop-display.conf && \
     rm -f /tmp/labloop-display.*"
# best-effort immediate patch too — covers the case where lab's panel
# config already exists (template re-provision after a session)
qga "python3 - <<'EOF'
import re
p = '/home/lab/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml'
try:
    xml = open(p).read()
except FileNotFoundError:
    raise SystemExit(0)
for m in re.finditer(r'(<property name=\"plugin-\d+\" type=\"empty\">)(.*?)(</property>)', xml, re.S):
    if 'value=\"clock\"' not in m.group(2):
        continue
    blk = m.group(2).replace(
        '<property name=\"digital-time-format\" type=\"empty\"/>',
        '<property name=\"digital-time-format\" type=\"string\" value=\"%H:%M %Z\"/>')
    if 'name=\"timezone\"' not in blk:
        blk = blk.rstrip() + '\n      <property name=\"timezone\" type=\"string\" value=\"UTC\"/>\n    '
    xml = xml[:m.start()] + m.group(1) + blk + m.group(3) + xml[m.end():]
    open(p, 'w').write(xml)
    break
EOF
chown lab:lab /home/lab/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml 2>/dev/null || true"
