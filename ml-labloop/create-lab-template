note "spice-vdagent installed (auto display-resize); clipboard stays off"
qga "apt-get install -y spice-vdagent"
# ^ vdagent is REQUIRED for guest resolution to follow the client
#   window (fullscreen = host monitor native res, shown in Display).
#   Clipboard is still dead: <clipboard copypaste='no'/> is enforced
#   server-side by QEMU's SPICE server — the agent cannot reopen it.
#   Do NOT purge vdagent; that was an earlier over-correction.

# cache plumbing must not persist in the frozen template: the apt
# source points at a build-time host address (dead in every clone),
# the wheelhouse is host-served scratch, and /tmp holds fetched
# tarballs. Strip them so clones carry no host references.
note "cache cleanup (source + wheelhouse never ship in the template)"
qga "rm -f /etc/apt/sources.list.d/labloop-cache.list && \
     rm -f /var/lib/apt/lists/*122.1.8777* /var/lib/apt/lists/*labloop-cache* 2>/dev/null; \
     rm -rf /srv/lab/wheelhouse /tmp/uvx-wheels"

# PASSWORD POLICY — the lab/exp password hash ships inside every clone
# and inside any published image, where it can be cracked offline at
# leisure. Rules:
#   1. Use a SHORT, UNIQUE throwaway password — never reuse a real one.
#   2. There is no sshd; login is console-only behind host auth, so a
#      weak-but-unique password is acceptable FOR LOCAL LAB USE ONLY.
#   3. LABLOOP_PUBLISH=1 locks both account passwords in the image —
#      mandatory before distributing the qcow2 (e.g. Hugging Face).
#      Clones of a locked image must set a password at first boot
#      (or log in via a previously-authorized key/console autologin).
if [ "${LABLOOP_PUBLISH:-0}" = "1" ]; then
    note "PUBLISH mode: locking lab+exp+mcp passwords in the image"
    qga "passwd -l lab && passwd -l exp && passwd -l mcp 2>/dev/null; \
         passwd -S lab | grep -q ' L ' && passwd -S exp | grep -q ' L '"
fi

# ubiquity under automatic mode can leave no nvram 'ubuntu' entry and no
# \EFI\BOOT\BOOTX64.EFI fallback — OVMF then drops to the UEFI shell on
# every boot, INCLUDING the first boot of this build (agent never comes
# up). --removable installs the fallback loader (covers this VM and any
# clone, whose nvram may differ), efibootmgr -c restores the named entry.
note "UEFI boot: ESP fallback loader + nvram entry"
qga "grub-install --target=x86_64-efi --efi-directory=/boot/efi \
     --removable --no-nvram"
qga "efibootmgr -c -d /dev/vda -p 1 -L ubuntu \
     -l '\EFI\ubuntu\shimx64.efi' 2>/dev/null \
     || efibootmgr -c -d /dev/vda -p 1 -L ubuntu \
        -l '\EFI\ubuntu\grubx64.efi' || true"

note "shutdown"
# the agent channel dies mid-poll when the guest powers off — expected
qga "systemctl poweroff" 2>/dev/null || true
for _ in $(seq 60); do
    [ "$($VIRSH domstate "$VM" 2>/dev/null)" = "shut off" ] && break
    sleep 5
done
[ "$($VIRSH domstate "$VM")" = "shut off" ] || die "$VM did not shut down"

note "XML hardening: clipboard=off, native ${RES_X}x${RES_Y}"
$VIRSH dumpxml --inactive "$VM" > "$WORK/dom.xml"
python3 - "$WORK/dom.xml" "$RES_X" "$RES_Y" <<'PYEOF'
import re, sys
path, x, y = sys.argv[1], sys.argv[2], sys.argv[3]
xml = open(path).read()
# clipboard off inside the spice graphics element
xml = re.sub(r"(<graphics type='spice'[^>]*>)",
             r"\1\n      <clipboard copypaste='no'/>", xml, count=1)
xml = xml.replace("<clipboard copypaste='yes'/>", "<clipboard copypaste='no'/>")
# native resolution on the video model; qxl also gets VRAM sizing.
# virtio is the default (no per-head TTM framebuffer to thrash —
# QXL's [TTM] buffer-eviction wedge froze the desktop twice even
# after vgamem was raised 32 -> 128 MiB); the qxl branch stays for
# domains built before the switch.
# NOTE: <model type='virtio'/> also appears on the NIC — search inside
# the <video> block or the NIC eats the resolution and libvirt drops it.
v = re.search(r"<video>.*?</video>", xml, re.S)
if v:
    seg = v.group(0)
    m = re.search(r"<model type='qxl'[^>]*>", seg)
    if m:
        sized = re.sub(r"\bram='\d+'", "ram='262144'",
            re.sub(r"\bvram='\d+'", "vram='131072'",
            re.sub(r"\bvgamem='\d+'", "vgamem='131072'", m.group(0))))
        seg = seg.replace(m.group(0), sized)
    m = re.search(r"<model type='(?:virtio|qxl)'[^>]*>", seg)
    if m and m.group(0).endswith("/>"):
        seg = seg.replace(m.group(0),
            m.group(0)[:-2] + ">\n"
            f"        <resolution x='{x}' y='{y}'/>\n      </model>")
    elif m and "<resolution" not in seg:
        seg = seg.replace(m.group(0),
            m.group(0) + "\n"
            f"        <resolution x='{x}' y='{y}'/>\n")
    xml = xml.replace(v.group(0), seg)
open(path, "w").write(xml)
PYEOF
$VIRSH define "$WORK/dom.xml" >/dev/null

# snp-vN: monotonic across BOTH naming eras — count pre-freeze-vN too
next=$($VIRSH snapshot-list --name "$VM" | \
       sed -n 's/^.*-\{0,1\}v\([0-9]\+\)$/\1/p' | sort -n | tail -1)
snap="snp-v$(( ${next:-0} + 1 ))"
$VIRSH snapshot-create-as "$VM" "$snap" "create-lab-template"

cat <<EOF

==> template '$VM' built, battery green, snapshotted as $snap.

    Next:
      sudo virt-sysprep -d $VM        # scrub machine-id/keys/hostname
      ./create-lab-user <name>        # per-user clone

    Revert point for future updates:
      virsh snapshot-revert $VM $snap && virsh start $VM
      (snapshot embeds the XML — re-snapshot after any host-side
       XML change, or the revert resurrects the old config)

    BEFORE PUBLISHING the image (Hugging Face etc.):
      rebuild/freeze with LABLOOP_PUBLISH=1 — locks lab+exp
      passwords inside the image. The hash is offline-crackable
      by anyone who downloads it. Never ship a reused password.
EOF
