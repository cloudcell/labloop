# Port layout for the ml-* MCP ecosystem.
# Sourced by run-ml-episteme.sh / run-ml-anamnesis.sh /
# run-ml-zetesis.sh / run-ml-arete.sh — change ports here, not in
# the scripts.
# All five servers live in the 38xxx block — it avoids collisions
# with common dev ports (docker-proxy binds 8080/8090 on some
# hosts). Agora (the lab status hub) takes the lowest block 3805x;
# Loop 0 takes 3808x, Loop 2 3806x, Loop 1 3807x; memory keeps
# 3809x.
#
# Lab status hub — read-only aggregation (ml-agora-mcp)
ML_AGORA_PORT=38050
ML_AGORA_GUI_PORT=38051
#
# Loop 2 — recursive loop (ml-arete-mcp)
ML_ARETE_PORT=38060
ML_ARETE_GUI_PORT=38061
#
# Loop 1 — search loop (ml-zetesis-mcp)
ML_ZETESIS_PORT=38070
ML_ZETESIS_GUI_PORT=38071
#
# Loop 0 — experiment loop (ml-episteme-mcp)
ML_EPISTEME_PORT=38080
ML_EPISTEME_GUI_PORT=38081
ML_EPISTEME_INGEST_PORT=38082
#
# Semantic memory — claims store (ml-anamnesis-mcp)
ML_ANAMNESIS_PORT=38090
ML_ANAMNESIS_GUI_PORT=38091
